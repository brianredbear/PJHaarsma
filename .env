# Canonical origin for OG tags, canonicals, and the sitemap.
# Temporary Railway URL now — change this to the real domain at launch.
VITE_SITE_URL=https://site-production-32b2.up.railway.app

# Set to true ONLY AFTER the custom domain is connected.
# While false: every page is noindex, and robots.txt blocks all crawlers.
VITE_ALLOW_INDEXING=false
